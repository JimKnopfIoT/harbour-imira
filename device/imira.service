[Unit]
Description=imira Miracast session service
After=multi-user.target network.target

[Service]
Type=simple
ExecStart=/usr/libexec/imira/imira-session.sh
Restart=on-failure
RestartSec=5
# Kein [Install]: nie boot-enabled. Die App startet die Unit (StartUnit,
# polkit-Regel); der Dienst beendet sich selbst, wenn der App-Heartbeat fehlt.
